{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@constants/*": ["src/constants/*"],
      "@contexts/*": ["src/contexts/*"],
      "@hooks/*": ["src/hooks/*"],
      "@services/*": ["src/services/*"],
      "@components/*": ["src/components/*"],
      "@screens/*": ["src/screens/*"],
      "@constants": ["src/constants/index", "src/constants/student", "src/constants/theme"],
      "@contexts": ["src/contexts/ThemeContext"],
      "@hooks": ["src/hooks/useCountdown"],
      "@services": ["src/services/productApi"],
      "@components": ["src/components/ui/Typography", "src/components/ui/ShopInput", "src/components/ui/ShopButton"],
      "@screens": ["src/screens/HomeScreen"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
